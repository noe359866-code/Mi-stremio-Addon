  "idPrefixes": [
    "tt",
    "ht",
    "pp",
    "ss",
    "kitsu"
  ],
  "behaviorHints": {
    "configurable": true,
    "configurationRequired": false
  },
  "config": [
    {
      "key": "idioma",
      "type": "select",
      "title": "Idioma del audio / Audio Language",
      "default": "ambos",
      "options": [
        "ambos",
        "espanol",
        "latino",
        "ingles"
      ]
    },
    {
      "key": "ui",
      "type": "select",
      "title": "Idioma de interfaz / Interface Language",
      "default": "es",
      "options": [
        "es",
        "en"
      ]
    },
    {
      "key": "fuentes",
      "type": "select",
      "title": "Servidores / Stream Sources",
      "default": "todas",
      "options": [
        "todas",
        "espanol",
        "ingles",
        "es1",
        "es2",
        "es3",
        "en1",
        "en2",
        "en3"
      ]
    },
    {
      "key": "calidad",
      "type": "select",
      "title": "Calidad mínima / Min Quality",
      "default": "cualquiera",
      "options": [
        "cualquiera",
        "720p",
        "1080p",
        "4k"
      ]
    },
    {
      "key": "orden",
      "type": "select",
      "title": "Orden de resultados / Sort Order",
      "default": "latino",
      "options": [
        "latino",
        "seeders",
        "calidad"
      ]
    },
    {
      "key": "max",
      "type": "number",
      "title": "Máximo de resultados / Max Results",
      "default": "25"
    },
    {
      "key": "packs",
      "type": "checkbox",
      "title": "Permitir packs de temporada / Allow Season Packs",
      "default": "true"
    }
  ]
}
