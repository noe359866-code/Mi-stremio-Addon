{
  "id": "com.hacktorrent.addon",
  "version": "1.5.0",
  "name": "HackTorrent",
  "description": "Catálogos y streams de películas, series y anime: HackTorrent.cc (Latino/Dual), Knaben, Torrents.csv y The Black Hole Bay opcional. Empareja por título, año y episodio exacto para evitar torrents equivocados.",
  "logo": "https://i.imgur.com/8N987Z7.png",
  "background": "https://image.tmdb.org/t/p/original//9BBTo63ANSmhC4e6r62OJFuK2GL.jpg",
  "resources": [
    "catalog",
    "stream",
    "meta"
  ],
  "types": [
    "movie",
    "series"
  ],
  "catalogs": [
    {
      "type": "movie",
      "id": "hacktorrent-peliculas",
      "name": "HackTorrent - Películas",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        },
        {
          "name": "genre",
          "isRequired": false,
          "options": [
            "Acción",
            "Aventura",
            "Comedia",
            "Drama",
            "Terror",
            "Suspense",
            "Ciencia ficción",
            "Animación",
            "Familia",
            "Crimen"
          ]
        },
        {
          "name": "skip",
          "isRequired": false
        }
      ]
    },
    {
      "type": "series",
      "id": "hacktorrent-series",
      "name": "HackTorrent - Series",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        },
        {
          "name": "skip",
          "isRequired": false
        }
      ]
    },
    {
      "type": "series",
      "id": "hacktorrent-anime",
      "name": "HackTorrent - Anime",
      "extra": [
        {
          "name": "search",
          "isRequired": false
        },
        {
          "name": "skip",
          "isRequired": false
        }
      ]
    }
  ],
  "idPrefixes": [
    "tt",
    "ht",
    "kitsu"
  ],
  "behaviorHints": {
    "configurable": true,
    "configurationRequired": false
  },
  "config": [
    {
      "key": "idioma",
      "type": "select",
      "title": "Idioma del audio",
      "default": "ambos",
      "options": [
        "ambos",
        "latino",
        "ingles"
      ]
    },
    {
      "key": "fuentes",
      "type": "select",
      "title": "Fuentes (ht,knaben,tbb,tcsv)",
      "default": "ht,knaben,tcsv",
      "options": [
        "ht",
        "knaben",
        "tbb",
        "tcsv",
        "ht,knaben",
        "ht,tbb",
        "ht,tcsv",
        "knaben,tbb",
        "knaben,tcsv",
        "tbb,tcsv",
        "ht,knaben,tbb",
        "ht,knaben,tcsv",
        "ht,tbb,tcsv",
        "knaben,tbb,tcsv",
        "ht,knaben,tbb,tcsv"
      ]
    },
    {
      "key": "calidad",
      "type": "select",
      "title": "Calidad mínima",
      "default": "cualquiera",
      "options": [
        "cualquiera",
        "720p",
        "1080p",
        "4k"
      ]
    },
    {
      "key": "orden",
      "type": "select",
      "title": "Orden de resultados",
      "default": "latino",
      "options": [
        "latino",
        "seeders",
        "calidad"
      ]
    },
    {
      "key": "max",
      "type": "number",
      "title": "Máximo de resultados",
      "default": "25"
    },
    {
      "key": "packs",
      "type": "checkbox",
      "title": "Permitir packs de temporada",
      "default": "true"
    }
  ]
}
