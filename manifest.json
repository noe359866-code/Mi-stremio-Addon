{
  "id": "com.univertorrent.addon",
  "version": "1.8.0",
  "name": "UniverTorrent",
  "description": "Streams de torrents para películas, series y anime en Español (Latino, Castellano y Dual) e Inglés (VO) en HD, 1080p y 4K. Sin catálogos.",
  "logo": "https://i.imgur.com/8N987Z7.png",
  "background": "https://image.tmdb.org/t/p/original//9BBTo63ANSmhC4e6r62OJFuK2GL.jpg",
  "resources": [
    "stream"
  ],
  "types": [
    "movie",
    "series",
    "anime"
  ],
  "catalogs": [],
  "idPrefixes": [
    "tt",
    "kitsu"
  ],
  "behaviorHints": {
    "p2p": true,
    "configurable": true,
    "configurationRequired": false
  },
  "config": [
    {
      "key": "idioma",
      "type": "select",
      "title": "Idioma del audio / Audio Language",
      "default": "ambos",
      "options": [
        "ambos",
        "espanol",
        "latino",
        "ingles"
      ]
    },
    {
      "key": "ui",
      "type": "select",
      "title": "Idioma de interfaz / Interface Language",
      "default": "es",
      "options": [
        "es",
        "en"
      ]
    },
    {
      "key": "fuentes",
      "type": "select",
      "title": "Servidores / Stream Sources",
      "default": "todas",
      "options": [
        "todas",
        "espanol",
        "ingles",
        "es1",
        "es2",
        "es3",
        "es4",
        "es5",
        "es6",
        "en1",
        "en2",
        "en3"
      ]
    },
    {
      "key": "calidad",
      "type": "select",
      "title": "Calidad mínima / Min Quality",
      "default": "cualquiera",
      "options": [
        "cualquiera",
        "720p",
        "1080p",
        "4k"
      ]
    },
    {
      "key": "orden",
      "type": "select",
      "title": "Orden de resultados / Sort Order",
      "default": "latino",
      "options": [
        "latino",
        "seeders",
        "calidad"
      ]
    },
    {
      "key": "max",
      "type": "number",
      "title": "Máximo de resultados / Max Results",
      "default": "25"
    },
    {
      "key": "packs",
      "type": "checkbox",
      "title": "Permitir packs de temporada / Allow Season Packs",
      "default": "true"
    }
  ]
}
